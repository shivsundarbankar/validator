<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://xlate.io/EDISchema/v4">

    <!-- ============================================================ -->
    <!-- TRANSACTION STRUCTURE (segment order + loop occurrence rules) -->
    <!-- ============================================================ -->
    <transaction>
        <sequence>

            <segment type="BEG" minOccurs="1" maxOccurs="1" />
            <segment type="REF" minOccurs="0" maxOccurs="12" />
            <segment type="PER" minOccurs="0" maxOccurs="3" />
            <segment type="DTM" minOccurs="0" maxOccurs="10" />

            <!-- Loop 1000 - Party Name -->
            <loop code="1000" minOccurs="0" maxOccurs="10">
                <sequence>
                    <segment type="N1"  minOccurs="1" maxOccurs="1" />
                    <segment type="N3"  minOccurs="0" maxOccurs="2" />
                    <segment type="N4"  minOccurs="0" maxOccurs="1" />
                    <segment type="REF" minOccurs="0" maxOccurs="12" />
                </sequence>
            </loop>

            <!-- Loop 2000 - Line Items -->
            <loop code="2000" minOccurs="1" maxOccurs="100000">
                <sequence>
                    <segment type="PO1" minOccurs="1" maxOccurs="1" />
                    <segment type="PID" minOccurs="0" maxOccurs="1000" />
                    <segment type="REF" minOccurs="0" maxOccurs="12" />
                </sequence>
            </loop>

            <segment type="CTT" minOccurs="1" maxOccurs="1" />
            <segment type="AMT" minOccurs="0" maxOccurs="1" />

        </sequence>
    </transaction>

    <!-- ============================================================ -->
    <!-- ELEMENT TYPE DEFINITIONS                                      -->
    <!-- base: string | numeric | decimal | date | time | identifier  -->
    <!-- ============================================================ -->

    <!-- Common elements -->
    <elementType name="E0001" base="identifier" minLength="2" maxLength="2" />   <!-- Transaction Set Purpose Code -->
    <elementType name="E0092" base="identifier" minLength="2" maxLength="2" />   <!-- PO Type Code -->
    <elementType name="E0324" base="string"     minLength="1" maxLength="22" />  <!-- PO Number -->
    <elementType name="E0373" base="date"       minLength="8" maxLength="8" />   <!-- Date -->
    <elementType name="E0128" base="identifier" minLength="2" maxLength="3" />   <!-- Reference ID Qualifier -->
    <elementType name="E0127" base="string"     minLength="1" maxLength="50" />  <!-- Reference ID -->
    <elementType name="E0366" base="identifier" minLength="2" maxLength="2" />   <!-- Contact Function Code -->
    <elementType name="E0093" base="string"     minLength="1" maxLength="60" />  <!-- Name -->
    <elementType name="E0365" base="identifier" minLength="2" maxLength="2" />   <!-- Communication Type -->
    <elementType name="E0364" base="string"     minLength="1" maxLength="80" />  <!-- Communication Number -->
    <elementType name="E0098" base="identifier" minLength="2" maxLength="3" />   <!-- Entity ID Code -->
    <elementType name="E0093b" base="string"    minLength="1" maxLength="60" />  <!-- Company Name -->
    <elementType name="E0066" base="identifier" minLength="1" maxLength="2" />   <!-- ID Code Qualifier -->
    <elementType name="E0067" base="string"     minLength="2" maxLength="80" />  <!-- ID Code -->
    <elementType name="E0166" base="string"     minLength="1" maxLength="55" />  <!-- Address -->
    <elementType name="E0019" base="string"     minLength="2" maxLength="30" />  <!-- City -->
    <elementType name="E0156" base="identifier" minLength="2" maxLength="2" />   <!-- State Code -->
    <elementType name="E0116" base="string"     minLength="3" maxLength="15" />  <!-- Postal Code -->
    <elementType name="E0026" base="identifier" minLength="2" maxLength="3" />   <!-- Country Code -->
    <elementType name="E0350" base="string"     minLength="1" maxLength="20" />  <!-- Assigned ID -->
    <elementType name="E0330" base="decimal"    minLength="1" maxLength="15" />  <!-- Quantity -->
    <elementType name="E0355" base="identifier" minLength="2" maxLength="2" />   <!-- Unit of Measure -->
    <elementType name="E0212" base="decimal"    minLength="1" maxLength="17" />  <!-- Unit Price -->
    <elementType name="E0235" base="identifier" minLength="2" maxLength="2" />   <!-- Product ID Qualifier -->
    <elementType name="E0234" base="string"     minLength="1" maxLength="48" />  <!-- Product ID -->
    <elementType name="E0354" base="numeric"    minLength="1" maxLength="6" />   <!-- Number of Line Items -->

    <!-- ============================================================ -->
    <!-- SEGMENT TYPE DEFINITIONS (element-level validation rules)    -->
    <!-- ============================================================ -->

    <!-- BEG - Beginning Segment for PO -->
    <segmentType name="BEG">
        <sequence>
            <element type="E0001" minOccurs="1" />  <!-- BEG01: Purpose Code -->
            <element type="E0092" minOccurs="1" />  <!-- BEG02: PO Type Code -->
            <element type="E0324" minOccurs="1" />  <!-- BEG03: PO Number -->
            <element type="E0324" minOccurs="0" />  <!-- BEG04: Release Number (not used) -->
            <element type="E0373" minOccurs="1" />  <!-- BEG05: Date (mandatory) -->
        </sequence>
    </segmentType>

    <!-- REF - Reference Identification -->
    <segmentType name="REF">
        <sequence>
            <element type="E0128" minOccurs="1" />  <!-- REF01: Qualifier -->
            <element type="E0127" minOccurs="0" />  <!-- REF02: Reference ID -->
        </sequence>
    </segmentType>

    <!-- PER - Administrative Communications Contact -->
    <segmentType name="PER">
        <sequence>
            <element type="E0366" minOccurs="1" />  <!-- PER01: Contact Function Code -->
            <element type="E0093" minOccurs="0" />  <!-- PER02: Name -->
            <element type="E0365" minOccurs="0" />  <!-- PER03: Comm Type -->
            <element type="E0364" minOccurs="0" />  <!-- PER04: Comm Number -->
        </sequence>
    </segmentType>

    <!-- DTM - Date/Time Reference -->
    <segmentType name="DTM">
        <sequence>
            <element type="E0374" minOccurs="1" />
            <element type="E0373" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N1 - Party Name -->
    <segmentType name="N1">
        <sequence>
            <element type="E0098"  minOccurs="1" />  <!-- N101: Entity ID Code -->
            <element type="E0093b" minOccurs="0" />  <!-- N102: Name -->
            <element type="E0066"  minOccurs="0" />  <!-- N103: ID Qualifier -->
            <element type="E0067"  minOccurs="0" />  <!-- N104: ID Code -->
        </sequence>
    </segmentType>

    <!-- N3 - Address -->
    <segmentType name="N3">
        <sequence>
            <element type="E0166" minOccurs="1" />
            <element type="E0166" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N4 - Geographic Location -->
    <segmentType name="N4">
        <sequence>
            <element type="E0019" minOccurs="0" />  <!-- City -->
            <element type="E0156" minOccurs="0" />  <!-- State -->
            <element type="E0116" minOccurs="0" />  <!-- ZIP -->
            <element type="E0026" minOccurs="0" />  <!-- Country -->
        </sequence>
    </segmentType>

    <!-- PO1 - Baseline Item Data -->
    <segmentType name="PO1">
        <sequence>
            <element type="E0350" minOccurs="0" />  <!-- PO101: Assigned ID -->
            <element type="E0330" minOccurs="1" />  <!-- PO102: Quantity (mandatory) -->
            <element type="E0355" minOccurs="1" />  <!-- PO103: Unit of Measure (mandatory) -->
            <element type="E0212" minOccurs="0" />  <!-- PO104: Unit Price -->
            <element type="E0235" minOccurs="0" />  <!-- PO105: Basis of Unit Price -->
            <element type="E0235" minOccurs="0" />  <!-- PO106: Product ID Qualifier -->
            <element type="E0234" minOccurs="0" />  <!-- PO107: Product ID -->
            <element type="E0235" minOccurs="0" />  <!-- PO108: Product ID Qualifier -->
            <element type="E0234" minOccurs="0" />  <!-- PO109: Product ID -->
        </sequence>
    </segmentType>

    <!-- PID - Product/Item Description -->
    <segmentType name="PID">
        <sequence>
            <element type="E0349" minOccurs="1" />
            <element type="E0350" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- CTT - Transaction Totals -->
    <segmentType name="CTT">
        <sequence>
            <element type="E0354" minOccurs="1" />  <!-- CTT01: Number of Line Items (mandatory) -->
        </sequence>
    </segmentType>

    <!-- AMT - Monetary Amount -->
    <segmentType name="AMT">
        <sequence>
            <element type="E0522" minOccurs="1" />
            <element type="E0782" minOccurs="1" />
        </sequence>
    </segmentType>

    <!-- Extra element types needed by DTM, PID, AMT -->
    <elementType name="E0374" base="identifier" minLength="3" maxLength="3" />  <!-- Date/Time Qualifier -->
    <elementType name="E0349" base="identifier" minLength="1" maxLength="1" />  <!-- Item Description Type -->
    <elementType name="E0522" base="identifier" minLength="2" maxLength="3" />  <!-- Amount Qualifier -->
    <elementType name="E0782" base="decimal"    minLength="1" maxLength="18" /> <!-- Monetary Amount -->

</schema>