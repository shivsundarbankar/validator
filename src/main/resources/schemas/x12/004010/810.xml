<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://xlate.io/EDISchema/v4">

    <transaction>
        <sequence>

            <!-- HEADER -->
            <segment type="BIG" minOccurs="1" maxOccurs="1" />
            <segment type="CUR" minOccurs="0" maxOccurs="1" />
            <segment type="REF" minOccurs="0" maxOccurs="12" />
            <segment type="PER" minOccurs="0" maxOccurs="3" />

            <!-- Loop 1000 - Party Identification (BEFORE ITD) -->
            <loop code="1000" minOccurs="0" maxOccurs="10">
                <sequence>
                    <segment type="N1"  minOccurs="1" maxOccurs="1" />
                    <segment type="N2"  minOccurs="0" maxOccurs="2" />
                    <segment type="N3"  minOccurs="0" maxOccurs="2" />
                    <segment type="N4"  minOccurs="0" maxOccurs="1" />
                    <segment type="REF" minOccurs="0" maxOccurs="12" />
                    <segment type="PER" minOccurs="0" maxOccurs="3" />
                </sequence>
            </loop>

            <!-- ITD and DTM come AFTER N1 loop in 004010 810 -->
            <segment type="ITD" minOccurs="0" maxOccurs="5" />
            <segment type="DTM" minOccurs="0" maxOccurs="10" />
            <segment type="FOB" minOccurs="0" maxOccurs="1" />

            <!-- DETAIL - Loop 2000 IT1 Line Items -->
            <loop code="2000" minOccurs="1" maxOccurs="200000">
                <sequence>
                    <segment type="IT1" minOccurs="1" maxOccurs="1" />
                    <segment type="CUR" minOccurs="0" maxOccurs="1" />
                    <segment type="IT3" minOccurs="0" maxOccurs="5" />
                    <loop code="2100" minOccurs="0" maxOccurs="1000">
                        <sequence>
                            <segment type="PID" minOccurs="1" maxOccurs="1" />
                        </sequence>
                    </loop>
                    <segment type="REF" minOccurs="0" maxOccurs="16" />
                    <segment type="DTM" minOccurs="0" maxOccurs="10" />
                    <segment type="TXI" minOccurs="0" maxOccurs="10" />


                    <loop code="2200" minOccurs="0" maxOccurs="25">
                        <sequence>
                            <segment type="SAC" minOccurs="1" maxOccurs="1" />
                            <segment type="TXI" minOccurs="0" maxOccurs="10" />
                        </sequence>
                    </loop>

                    <segment type="QTY" minOccurs="0" maxOccurs="5" />
                </sequence>
            </loop>

            <!-- SUMMARY -->
            <segment type="TDS" minOccurs="1" maxOccurs="1" />
            <segment type="TXI" minOccurs="0" maxOccurs="10" />

            <loop code="3000" minOccurs="0" maxOccurs="25">
                <sequence>
                    <segment type="SAC" minOccurs="1" maxOccurs="1" />
                    <segment type="TXI" minOccurs="0" maxOccurs="10" />
                </sequence>
            </loop>

            <segment type="CTT" minOccurs="1" maxOccurs="1" />
            <segment type="AMT" minOccurs="0" maxOccurs="1" />

        </sequence>
    </transaction>

    <!-- ============================================================ -->
    <!-- ELEMENT TYPES                                                 -->
    <!-- ============================================================ -->
    <elementType name="E_DATE"     base="date"       minLength="8"  maxLength="8"  />
    <elementType name="E_TIME"     base="time"       minLength="4"  maxLength="8"  />
    <elementType name="E_DTM_QUAL" base="identifier" minLength="3"  maxLength="3"  />
    <elementType name="E_AMOUNT"   base="decimal"    minLength="1"  maxLength="18" />
    <elementType name="E_QTY"      base="decimal"    minLength="1"  maxLength="15" />
    <elementType name="E_PRICE"    base="decimal"    minLength="1"  maxLength="17" />
    <elementType name="E_NUMERIC"  base="numeric"    minLength="1"  maxLength="9"  />
    <elementType name="E_STR_1_10" base="string"     minLength="1"  maxLength="10" />
    <elementType name="E_STR_1_12" base="string"     minLength="1"  maxLength="12" />
    <elementType name="E_STR_1_15" base="string"     minLength="1"  maxLength="15" />
    <elementType name="E_STR_1_20" base="string"     minLength="1"  maxLength="20" />
    <elementType name="E_STR_1_22" base="string"     minLength="1"  maxLength="22" />
    <elementType name="E_STR_1_30" base="string"     minLength="1"  maxLength="30" />
    <elementType name="E_STR_1_35" base="string"     minLength="1"  maxLength="35" />
    <elementType name="E_STR_1_48" base="string"     minLength="1"  maxLength="48" />
    <elementType name="E_STR_1_50" base="string"     minLength="1"  maxLength="50" />
    <elementType name="E_STR_1_55" base="string"     minLength="1"  maxLength="55" />
    <elementType name="E_STR_1_60" base="string"     minLength="1"  maxLength="60" />
    <elementType name="E_STR_1_80" base="string"     minLength="1"  maxLength="80" />
    <elementType name="E_STR_2_80" base="string"     minLength="2"  maxLength="80" />
    <elementType name="E_ID_1_2"   base="identifier" minLength="1"  maxLength="2"  />
    <elementType name="E_ID_2_2"   base="identifier" minLength="2"  maxLength="2"  />
    <elementType name="E_ID_2_3"   base="identifier" minLength="2"  maxLength="3"  />
    <elementType name="E_ID_2_4"   base="identifier" minLength="2"  maxLength="4"  />
    <elementType name="E_ID_3_3"   base="identifier" minLength="3"  maxLength="3"  />

    <!-- ============================================================ -->
    <!-- SEGMENT TYPES                                                 -->
    <!-- ============================================================ -->

    <!-- BIG - Beginning Segment for Invoice -->
    <segmentType name="BIG">
        <sequence>
            <element type="E_DATE"     minOccurs="1" />
            <element type="E_STR_1_22" minOccurs="1" />
            <element type="E_DATE"     minOccurs="0" />
            <element type="E_STR_1_22" minOccurs="0" />
            <element type="E_STR_1_30" minOccurs="0" />
            <element type="E_STR_1_10" minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- CUR - Currency -->
    <segmentType name="CUR">
        <sequence>
            <element type="E_ID_2_3" minOccurs="1" />
            <element type="E_ID_3_3" minOccurs="1" />
            <element type="E_PRICE"  minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- REF - Reference Identification -->
    <segmentType name="REF">
        <sequence>
            <element type="E_ID_2_3"   minOccurs="1" />
            <element type="E_STR_1_50" minOccurs="0" />
            <element type="E_STR_1_80" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- PER - Administrative Communications Contact -->
    <segmentType name="PER">
        <sequence>
            <element type="E_ID_2_2"   minOccurs="1" />
            <element type="E_STR_1_60" minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_80" minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_80" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N1 - Party Name -->
    <segmentType name="N1">
        <sequence>
            <element type="E_ID_2_3"   minOccurs="1" />
            <element type="E_STR_1_60" minOccurs="0" />
            <element type="E_ID_1_2"   minOccurs="0" />
            <element type="E_STR_2_80" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N2 - Additional Name Information -->
    <segmentType name="N2">
        <sequence>
            <element type="E_STR_1_60" minOccurs="1" />
            <element type="E_STR_1_60" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N3 - Address Information -->
    <segmentType name="N3">
        <sequence>
            <element type="E_STR_1_55" minOccurs="1" />
            <element type="E_STR_1_55" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N4 - Geographic Location -->
    <segmentType name="N4">
        <sequence>
            <element type="E_STR_1_30" minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_15" minOccurs="0" />
            <element type="E_ID_2_3"   minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- ITD - Terms of Sale -->
    <segmentType name="ITD">
        <sequence>
            <element type="E_ID_2_2"  minOccurs="0" />
            <element type="E_ID_1_2"  minOccurs="0" />
            <element type="E_PRICE"   minOccurs="0" />
            <element type="E_DATE"    minOccurs="0" />
            <element type="E_NUMERIC" minOccurs="0" />
            <element type="E_DATE"    minOccurs="0" />
            <element type="E_NUMERIC" minOccurs="0" />
            <element type="E_AMOUNT"  minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- DTM - Date/Time Reference -->
    <segmentType name="DTM">
        <sequence>
            <element type="E_DTM_QUAL" minOccurs="1" />
            <element type="E_DATE"     minOccurs="0" />
            <element type="E_TIME"     minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- FOB - F.O.B. Related Instructions -->
    <segmentType name="FOB">
        <sequence>
            <element type="E_ID_2_2"   minOccurs="1" />
            <element type="E_ID_1_2"   minOccurs="0" />
            <element type="E_STR_1_80" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- IT1 - Baseline Item Data -->
    <segmentType name="IT1">
        <sequence>
            <element type="E_STR_1_20" minOccurs="0" />
            <element type="E_QTY"      minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_PRICE"    minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_48" minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_48" minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_48" minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_48" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- IT3 - Additional Item Data -->
    <segmentType name="IT3">
        <sequence>
            <element type="E_QTY"    minOccurs="0" />
            <element type="E_ID_2_2" minOccurs="0" />
            <element type="E_ID_1_2" minOccurs="0" />
            <element type="E_PRICE"  minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- TXI - Tax Information -->
    <segmentType name="TXI">
        <sequence>
            <element type="E_ID_2_2"   minOccurs="1" />
            <element type="E_AMOUNT"   minOccurs="0" />
            <element type="E_PRICE"    minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_10" minOccurs="0" />
            <element type="E_ID_1_2"   minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- PID - Product/Item Description -->
    <segmentType name="PID">
        <sequence>
            <element type="E_ID_1_2"   minOccurs="1" />
            <element type="E_ID_2_3"   minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_12" minOccurs="0" />
            <element type="E_STR_1_80" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- SAC - Service, Promotion, Allowance, or Charge -->
    <segmentType name="SAC">
        <sequence>
            <element type="E_ID_1_2"   minOccurs="1" />
            <element type="E_ID_2_4"   minOccurs="0" />
            <element type="E_ID_2_2"   minOccurs="0" />
            <element type="E_STR_1_10" minOccurs="0" />
            <element type="E_AMOUNT"   minOccurs="0" />
            <element type="E_ID_1_2"   minOccurs="0" />
            <element type="E_PRICE"    minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- QTY - Quantity -->
    <segmentType name="QTY">
        <sequence>
            <element type="E_ID_2_2" minOccurs="1" />
            <element type="E_QTY"    minOccurs="1" />
            <element type="E_ID_2_2" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- TDS - Total Monetary Value Summary -->
    <segmentType name="TDS">
        <sequence>
            <element type="E_AMOUNT" minOccurs="1" />
            <element type="E_AMOUNT" minOccurs="0" />
            <element type="E_AMOUNT" minOccurs="0" />
            <element type="E_AMOUNT" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- CTT - Transaction Totals -->
    <segmentType name="CTT">
        <sequence>
            <element type="E_NUMERIC" minOccurs="1" />
            <element type="E_QTY"     minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- AMT - Monetary Amount -->
    <segmentType name="AMT">
        <sequence>
            <element type="E_ID_1_2" minOccurs="1" />
            <element type="E_AMOUNT" minOccurs="1" />
        </sequence>
    </segmentType>

</schema>