<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://xlate.io/EDISchema/v4">

    <!-- ============================================================ -->
    <!-- X12 004010 856 — Ship Notice / Manifest (ASN)               -->
    <!--                                                              -->
    <!-- HL hierarchy: Shipment (S) > Order (O) > Pack (P) > Item (I)-->
    <!-- The parent-child relationship is resolved at runtime via     -->
    <!-- HL01 (ID) and HL02 (parent ID); the schema uses a single    -->
    <!-- repeating HL loop containing all level-specific segments.    -->
    <!-- ============================================================ -->

    <transaction>
        <sequence>

            <segment type="BSN" minOccurs="1" maxOccurs="1" />
            <segment type="DTM" minOccurs="0" maxOccurs="10" />

            <!-- HL loop — repeats for every hierarchical level (S / O / P / I).   -->
            <!-- HL03 value in the data identifies the level; segments that are     -->
            <!-- only valid at one level are defined here as optional (minOccurs=0) -->
            <!-- so the schema stays flexible across all hierarchy configurations.  -->
            <loop code="0200" minOccurs="1" maxOccurs="200000">
                <sequence>

                    <segment type="HL"  minOccurs="1" maxOccurs="1" />

                    <!-- Shipment level (HL03 = S) -->
                    <segment type="TD1" minOccurs="0" maxOccurs="2" />
                    <segment type="TD5" minOccurs="0" maxOccurs="12" />
                    <segment type="TD3" minOccurs="0" maxOccurs="7" />
                    <segment type="TD4" minOccurs="0" maxOccurs="5" />
                    <segment type="MAN" minOccurs="0" maxOccurs="10" />
                    <segment type="PKG" minOccurs="0" maxOccurs="10" />

                    <!-- Order level (HL03 = O) -->
                    <segment type="PRF" minOccurs="0" maxOccurs="1" />

                    <!-- Shared across multiple levels -->
                    <segment type="REF" minOccurs="0" maxOccurs="10" />
                    <segment type="DTM" minOccurs="0" maxOccurs="10" />

                    <!-- Item level (HL03 = I) -->
                    <segment type="LIN" minOccurs="0" maxOccurs="1" />
                    <segment type="SN1" minOccurs="0" maxOccurs="1" />
                    <segment type="PID" minOccurs="0" maxOccurs="1000" />
                    <segment type="MEA" minOccurs="0" maxOccurs="40" />

                    <!-- Party Name loop (primarily shipment level, code 0400) -->
                    <loop code="0400" minOccurs="0" maxOccurs="10">
                        <sequence>
                            <segment type="N1"  minOccurs="1" maxOccurs="1" />
                            <segment type="N2"  minOccurs="0" maxOccurs="2" />
                            <segment type="N3"  minOccurs="0" maxOccurs="2" />
                            <segment type="N4"  minOccurs="0" maxOccurs="1" />
                            <segment type="REF" minOccurs="0" maxOccurs="5" />
                            <segment type="PER" minOccurs="0" maxOccurs="3" />
                        </sequence>
                    </loop>

                </sequence>
            </loop>

            <segment type="CTT" minOccurs="1" maxOccurs="1" />

        </sequence>
    </transaction>


    <!-- ============================================================ -->
    <!-- ELEMENT TYPE DEFINITIONS                                      -->
    <!-- ============================================================ -->

    <!-- ── Shared / common ───────────────────────────────────────── -->
    <elementType name="E0019"  base="string"     minLength="2"  maxLength="30"  /> <!-- City Name -->
    <elementType name="E0026"  base="identifier" minLength="2"  maxLength="3"   /> <!-- Country Code -->
    <elementType name="E0066"  base="identifier" minLength="1"  maxLength="2"   /> <!-- ID Code Qualifier -->
    <elementType name="E0067"  base="string"     minLength="2"  maxLength="80"  /> <!-- ID Code -->
    <elementType name="E0091"  base="identifier" minLength="1"  maxLength="2"   /> <!-- Transportation Method Code -->
    <elementType name="E0093"  base="string"     minLength="1"  maxLength="60"  /> <!-- Name -->
    <elementType name="E0098"  base="identifier" minLength="2"  maxLength="3"   /> <!-- Entity Identifier Code -->
    <elementType name="E0116"  base="string"     minLength="3"  maxLength="15"  /> <!-- Postal Code -->
    <elementType name="E0127"  base="string"     minLength="1"  maxLength="50"  /> <!-- Reference Identification -->
    <elementType name="E0128"  base="identifier" minLength="2"  maxLength="3"   /> <!-- Reference Identification Qualifier -->
    <elementType name="E0156"  base="identifier" minLength="2"  maxLength="2"   /> <!-- State/Province Code -->
    <elementType name="E0166"  base="string"     minLength="1"  maxLength="55"  /> <!-- Address Information -->
    <elementType name="E0234"  base="string"     minLength="1"  maxLength="48"  /> <!-- Product/Service ID -->
    <elementType name="E0235"  base="identifier" minLength="2"  maxLength="2"   /> <!-- Product/Service ID Qualifier -->
    <elementType name="E0330"  base="decimal"    minLength="1"  maxLength="9"   /> <!-- Quantity -->
    <elementType name="E0337"  base="time"       minLength="4"  maxLength="8"   /> <!-- Time (HHMM–HHMMSS) -->
    <elementType name="E0349"  base="identifier" minLength="1"  maxLength="1"   /> <!-- Item Description Type (F/S/X) -->
    <elementType name="E0350"  base="string"     minLength="1"  maxLength="20"  /> <!-- Assigned Identification -->
    <elementType name="E0352"  base="string"     minLength="1"  maxLength="80"  /> <!-- Description -->
    <elementType name="E0354"  base="numeric"    minLength="1"  maxLength="6"   /> <!-- Number of Line Items -->
    <elementType name="E0355"  base="identifier" minLength="2"  maxLength="2"   /> <!-- Unit or Basis for Measurement Code -->
    <elementType name="E0364"  base="string"     minLength="1"  maxLength="80"  /> <!-- Communication Number -->
    <elementType name="E0365"  base="identifier" minLength="2"  maxLength="2"   /> <!-- Communication Number Qualifier -->
    <elementType name="E0366"  base="identifier" minLength="2"  maxLength="2"   /> <!-- Contact Function Code -->
    <elementType name="E0373"  base="date"       minLength="8"  maxLength="8"   /> <!-- Date (CCYYMMDD) -->
    <elementType name="E0374"  base="identifier" minLength="3"  maxLength="3"   /> <!-- Date/Time Qualifier -->

    <!-- ── BSN — Beginning Segment for Ship Notice ───────────────── -->
    <elementType name="E0353"  base="identifier" minLength="2"  maxLength="3"   /> <!-- BSN01: Shipment Identification Code -->
    <elementType name="E0396"  base="string"     minLength="2"  maxLength="30"  /> <!-- BSN02: Shipment Identification Number -->
    <elementType name="E0328"  base="identifier" minLength="3"  maxLength="3"   /> <!-- BSN05: Hierarchical Structure Code -->

    <!-- ── HL — Hierarchical Level ───────────────────────────────── -->
    <elementType name="E0628"  base="string"     minLength="1"  maxLength="12"  /> <!-- HL01: Hierarchical ID Number -->
    <elementType name="E0734"  base="string"     minLength="1"  maxLength="12"  /> <!-- HL02: Hierarchical Parent ID -->
    <elementType name="E0735"  base="identifier" minLength="1"  maxLength="2"   /> <!-- HL03: Level Code (S/O/P/I/F) -->
    <elementType name="E0736"  base="identifier" minLength="1"  maxLength="1"   /> <!-- HL04: Hierarchical Child Code (0=leaf, 1=has children) -->

    <!-- ── TD1 — Carrier Details (Quantity and Weight) ───────────── -->
    <elementType name="E0103"  base="identifier" minLength="3"  maxLength="5"   /> <!-- Packaging Code -->
    <elementType name="E0080"  base="numeric"    minLength="1"  maxLength="7"   /> <!-- Lading Quantity -->
    <elementType name="E0083"  base="identifier" minLength="1"  maxLength="2"   /> <!-- Commodity Code Qualifier (TD103) -->
    <elementType name="E0122"  base="string"     minLength="1"  maxLength="30"  /> <!-- Commodity Code (TD104) -->
    <elementType name="E0183"  base="decimal"    minLength="1"  maxLength="10"  /> <!-- Lading Weight -->
    <elementType name="E0187"  base="identifier" minLength="1"  maxLength="2"   /> <!-- Weight Qualifier -->
    <elementType name="E0184"  base="identifier" minLength="1"  maxLength="1"   /> <!-- Weight Unit Code (L=lbs, K=kg) -->

    <!-- ── TD5 — Carrier Details (Routing Sequence) ──────────────── -->
    <elementType name="E0133"  base="identifier" minLength="1"  maxLength="2"   /> <!-- Routing Sequence Code -->
    <elementType name="E0387"  base="string"     minLength="1"  maxLength="35"  /> <!-- Routing -->

    <!-- ── TD3 — Carrier Details (Equipment) ─────────────────────── -->
    <elementType name="E0040"  base="identifier" minLength="2"  maxLength="2"   /> <!-- Equipment Description Code -->
    <elementType name="E0206"  base="string"     minLength="1"  maxLength="4"   /> <!-- Equipment Initial -->
    <elementType name="E0207"  base="string"     minLength="1"  maxLength="10"  /> <!-- Equipment Number -->

    <!-- ── TD4 — Carrier Details (Special Handling) ──────────────── -->
    <elementType name="E0152"  base="identifier" minLength="2"  maxLength="3"   /> <!-- Special Handling Code -->

    <!-- ── MAN — Marks and Numbers ───────────────────────────────── -->
    <elementType name="E0672"  base="identifier" minLength="1"  maxLength="2"   /> <!-- Marks and Numbers Qualifier -->
    <elementType name="E0673"  base="string"     minLength="1"  maxLength="48"  /> <!-- Marks and Numbers -->

    <!-- ── PKG — Marking, Packaging, Loading ─────────────────────── -->
    <elementType name="E0753"  base="identifier" minLength="3"  maxLength="5"   /> <!-- Packaging Characteristic Code -->
    <elementType name="E0559"  base="identifier" minLength="2"  maxLength="2"   /> <!-- Agency Qualifier Code -->
    <elementType name="E0754"  base="string"     minLength="1"  maxLength="7"   /> <!-- Packaging Description Code -->

    <!-- ── PRF — Purchase Order Reference ────────────────────────── -->
    <elementType name="E0324"  base="string"     minLength="1"  maxLength="22"  /> <!-- Purchase Order Number -->
    <elementType name="E0328b" base="string"     minLength="1"  maxLength="30"  /> <!-- Release Number -->
    <elementType name="E0329"  base="string"     minLength="1"  maxLength="8"   /> <!-- Change Order Sequence Number -->

    <!-- ── LIN — Item Identification ─────────────────────────────── -->
    <!-- Uses E0235, E0234, E0350 defined above -->

    <!-- ── SN1 — Item Detail (Shipment) ──────────────────────────── -->
    <elementType name="E0382"  base="decimal"    minLength="1"  maxLength="10"  /> <!-- Number of Units Shipped -->

    <!-- ── PID — Product/Item Description ────────────────────────── -->
    <elementType name="E0750"  base="identifier" minLength="2"  maxLength="3"   /> <!-- PID02: Product/Process Characteristic Code -->
    <elementType name="E0751"  base="string"     minLength="1"  maxLength="12"  /> <!-- PID04: Product Description Code -->

    <!-- ── MEA — Measurements ────────────────────────────────────── -->
    <elementType name="E0737"  base="identifier" minLength="2"  maxLength="2"   /> <!-- Measurement Reference ID Code -->
    <elementType name="E0738"  base="identifier" minLength="1"  maxLength="3"   /> <!-- Measurement Qualifier -->
    <elementType name="E0739"  base="decimal"    minLength="1"  maxLength="20"  /> <!-- Measurement Value -->

    <!-- ── CTT02 (optional hash total) ───────────────────────────── -->
    <elementType name="E0347"  base="decimal"    minLength="1"  maxLength="10"  /> <!-- Hash Total -->


    <!-- ============================================================ -->
    <!-- SEGMENT TYPE DEFINITIONS                                      -->
    <!-- ============================================================ -->

    <!-- BSN — Beginning Segment for Ship Notice -->
    <segmentType name="BSN">
        <sequence>
            <element type="E0353" minOccurs="1" />  <!-- BSN01: Shipment Identification Code (e.g. 00=Original) -->
            <element type="E0396" minOccurs="1" />  <!-- BSN02: Shipment Identification Number -->
            <element type="E0373" minOccurs="1" />  <!-- BSN03: Date (CCYYMMDD) -->
            <element type="E0337" minOccurs="1" />  <!-- BSN04: Time (HHMM) -->
            <element type="E0328" minOccurs="0" />  <!-- BSN05: Hierarchical Structure Code (e.g. 0001=S>O>I, 0002=S>O>P>I) -->
        </sequence>
    </segmentType>

    <!-- DTM — Date/Time Reference -->
    <segmentType name="DTM">
        <sequence>
            <element type="E0374" minOccurs="1" />  <!-- DTM01: Date/Time Qualifier (011=Shipped, 017=Estimated Delivery, etc.) -->
            <element type="E0373" minOccurs="0" />  <!-- DTM02: Date -->
            <element type="E0337" minOccurs="0" />  <!-- DTM03: Time -->
        </sequence>
    </segmentType>

    <!-- HL — Hierarchical Level -->
    <segmentType name="HL">
        <sequence>
            <element type="E0628" minOccurs="1" />  <!-- HL01: Hierarchical ID Number (sequential, starts at 1) -->
            <element type="E0734" minOccurs="0" />  <!-- HL02: Hierarchical Parent ID (absent on root Shipment HL) -->
            <element type="E0735" minOccurs="1" />  <!-- HL03: Level Code (S=Shipment, O=Order, P=Pack, I=Item) -->
            <element type="E0736" minOccurs="0" />  <!-- HL04: Hierarchical Child Code (1=has children, 0=leaf node) -->
        </sequence>
    </segmentType>

    <!-- TD1 — Carrier Details (Quantity and Weight) -->
    <segmentType name="TD1">
        <sequence>
            <element type="E0103" minOccurs="0" />  <!-- TD101: Packaging Code (e.g. PLT=Pallet, CTN=Carton) -->
            <element type="E0080" minOccurs="0" />  <!-- TD102: Lading Quantity -->
            <element type="E0083" minOccurs="0" />  <!-- TD103: Commodity Code Qualifier -->
            <element type="E0122" minOccurs="0" />  <!-- TD104: Commodity Code -->
            <element type="E0183" minOccurs="0" />  <!-- TD105: Lading Weight -->
            <element type="E0187" minOccurs="0" />  <!-- TD106: Weight Qualifier (G=Gross, N=Net) -->
            <element type="E0184" minOccurs="0" />  <!-- TD107: Weight Unit Code (L=Pounds, K=Kilograms) -->
        </sequence>
    </segmentType>

    <!-- TD5 — Carrier Details (Routing Sequence / Transit Time) -->
    <segmentType name="TD5">
        <sequence>
            <element type="E0133" minOccurs="0" />  <!-- TD501: Routing Sequence Code (B=Origin, A=Destination) -->
            <element type="E0066" minOccurs="0" />  <!-- TD502: ID Code Qualifier (2=SCAC, ZZ=Mutually Defined) -->
            <element type="E0067" minOccurs="0" />  <!-- TD503: ID Code (carrier SCAC or code) -->
            <element type="E0091" minOccurs="0" />  <!-- TD504: Transportation Method (A=Air, M=Motor, R=Rail, S=Ocean) -->
            <element type="E0387" minOccurs="0" />  <!-- TD505: Routing (free-form routing description) -->
        </sequence>
    </segmentType>

    <!-- TD3 — Carrier Details (Equipment) -->
    <segmentType name="TD3">
        <sequence>
            <element type="E0040" minOccurs="0" />  <!-- TD301: Equipment Description Code (TL=Trailer, CN=Container) -->
            <element type="E0206" minOccurs="0" />  <!-- TD302: Equipment Initial (rail car initial) -->
            <element type="E0207" minOccurs="0" />  <!-- TD303: Equipment Number (trailer/container number) -->
            <element type="E0066" minOccurs="0" />  <!-- TD304: Seal Number Qualifier -->
            <element type="E0067" minOccurs="0" />  <!-- TD305: Seal Number -->
        </sequence>
    </segmentType>

    <!-- TD4 — Carrier Details (Special Handling, Hazardous Materials) -->
    <segmentType name="TD4">
        <sequence>
            <element type="E0152" minOccurs="0" />  <!-- TD401: Special Handling Code -->
            <element type="E0152" minOccurs="0" />  <!-- TD402: Special Handling Code 2 (optional second code) -->
        </sequence>
    </segmentType>

    <!-- MAN — Marks and Numbers (carton/pallet labels, SSCCs) -->
    <segmentType name="MAN">
        <sequence>
            <element type="E0672" minOccurs="1" />  <!-- MAN01: Qualifier (GM=SSCC-18, CP=Customer PO, UC=UCC-128) -->
            <element type="E0673" minOccurs="1" />  <!-- MAN02: Marks and Numbers (label value) -->
            <element type="E0672" minOccurs="0" />  <!-- MAN03: Qualifier 2 -->
            <element type="E0673" minOccurs="0" />  <!-- MAN04: Marks and Numbers 2 -->
        </sequence>
    </segmentType>

    <!-- PKG — Marking, Packaging, Loading -->
    <segmentType name="PKG">
        <sequence>
            <element type="E0349" minOccurs="0" />  <!-- PKG01: Item Description Type (F/S/X) -->
            <element type="E0753" minOccurs="0" />  <!-- PKG02: Packaging Characteristic Code -->
            <element type="E0559" minOccurs="0" />  <!-- PKG03: Agency Qualifier Code -->
            <element type="E0754" minOccurs="0" />  <!-- PKG04: Packaging Description Code -->
            <element type="E0352" minOccurs="0" />  <!-- PKG05: Description (free-form packaging description) -->
        </sequence>
    </segmentType>

    <!-- PRF — Purchase Order Reference (at Order level) -->
    <segmentType name="PRF">
        <sequence>
            <element type="E0324"  minOccurs="1" />  <!-- PRF01: Purchase Order Number -->
            <element type="E0328b" minOccurs="0" />  <!-- PRF02: Release Number -->
            <element type="E0329"  minOccurs="0" />  <!-- PRF03: Change Order Sequence Number -->
            <element type="E0373"  minOccurs="0" />  <!-- PRF04: Purchase Order Date -->
        </sequence>
    </segmentType>

    <!-- REF — Reference Identification -->
    <segmentType name="REF">
        <sequence>
            <element type="E0128" minOccurs="1" />  <!-- REF01: Qualifier (BM=B/L, CN=Carrier PRO, VN=Vendor, SI=Shipper ID) -->
            <element type="E0127" minOccurs="0" />  <!-- REF02: Reference ID value -->
        </sequence>
    </segmentType>

    <!-- LIN — Item Identification (at Item level) -->
    <segmentType name="LIN">
        <sequence>
            <element type="E0350" minOccurs="0" />  <!-- LIN01: Assigned ID (line item number within shipment) -->
            <element type="E0235" minOccurs="1" />  <!-- LIN02: Product/Service ID Qualifier (UP=UPC, IN=Buyer's, VN=Vendor's) -->
            <element type="E0234" minOccurs="1" />  <!-- LIN03: Product/Service ID -->
            <!-- Additional qualifier + ID pairs (LIN04/05 through LIN30/31) -->
            <element type="E0235" minOccurs="0" />  <!-- LIN04 -->
            <element type="E0234" minOccurs="0" />  <!-- LIN05 -->
            <element type="E0235" minOccurs="0" />  <!-- LIN06 -->
            <element type="E0234" minOccurs="0" />  <!-- LIN07 -->
            <element type="E0235" minOccurs="0" />  <!-- LIN08 -->
            <element type="E0234" minOccurs="0" />  <!-- LIN09 -->
            <element type="E0235" minOccurs="0" />  <!-- LIN10 -->
            <element type="E0234" minOccurs="0" />  <!-- LIN11 -->
        </sequence>
    </segmentType>

    <!-- SN1 — Item Detail (Shipment) -->
    <segmentType name="SN1">
        <sequence>
            <element type="E0350" minOccurs="0" />  <!-- SN101: Assigned ID -->
            <element type="E0382" minOccurs="1" />  <!-- SN102: Number of Units Shipped (actual quantity) -->
            <element type="E0355" minOccurs="1" />  <!-- SN103: Unit of Measurement Code (EA, CA, PL, etc.) -->
            <element type="E0330" minOccurs="0" />  <!-- SN104: Quantity Ordered (original PO quantity) -->
        </sequence>
    </segmentType>

    <!-- PID — Product/Item Description -->
    <segmentType name="PID">
        <sequence>
            <element type="E0349" minOccurs="1" />  <!-- PID01: Item Description Type (F=Free-form, S=Structured) -->
            <element type="E0750" minOccurs="0" />  <!-- PID02: Product/Process Characteristic Code -->
            <element type="E0559" minOccurs="0" />  <!-- PID03: Agency Qualifier Code -->
            <element type="E0751" minOccurs="0" />  <!-- PID04: Product Description Code -->
            <element type="E0352" minOccurs="0" />  <!-- PID05: Description (free-form text) -->
        </sequence>
    </segmentType>

    <!-- MEA — Measurements (dimensions, weight at item level) -->
    <segmentType name="MEA">
        <sequence>
            <element type="E0737" minOccurs="0" />  <!-- MEA01: Measurement Reference ID Code (PD=Product Dimension, WT=Weight) -->
            <element type="E0738" minOccurs="0" />  <!-- MEA02: Measurement Qualifier (HT=Height, WT=Width, LN=Length, GW=Gross Weight) -->
            <element type="E0739" minOccurs="0" />  <!-- MEA03: Measurement Value -->
            <element type="E0355" minOccurs="0" />  <!-- MEA04: Unit of Measurement (IN, FT, LB, KG, etc.) -->
        </sequence>
    </segmentType>

    <!-- N1 — Party Name -->
    <segmentType name="N1">
        <sequence>
            <element type="E0098" minOccurs="1" />  <!-- N101: Entity Identifier Code (ST=Ship To, SF=Ship From, BY=Buyer, SE=Seller) -->
            <element type="E0093" minOccurs="0" />  <!-- N102: Name -->
            <element type="E0066" minOccurs="0" />  <!-- N103: ID Code Qualifier -->
            <element type="E0067" minOccurs="0" />  <!-- N104: ID Code -->
        </sequence>
    </segmentType>

    <!-- N2 — Additional Name Information -->
    <segmentType name="N2">
        <sequence>
            <element type="E0093" minOccurs="1" />  <!-- N201: Name (continuation line 1) -->
            <element type="E0093" minOccurs="0" />  <!-- N202: Name (continuation line 2) -->
        </sequence>
    </segmentType>

    <!-- N3 — Address Information -->
    <segmentType name="N3">
        <sequence>
            <element type="E0166" minOccurs="1" />  <!-- N301: Address Line 1 -->
            <element type="E0166" minOccurs="0" />  <!-- N302: Address Line 2 -->
        </sequence>
    </segmentType>

    <!-- N4 — Geographic Location -->
    <segmentType name="N4">
        <sequence>
            <element type="E0019" minOccurs="0" />  <!-- N401: City Name -->
            <element type="E0156" minOccurs="0" />  <!-- N402: State/Province Code -->
            <element type="E0116" minOccurs="0" />  <!-- N403: Postal Code -->
            <element type="E0026" minOccurs="0" />  <!-- N404: Country Code -->
        </sequence>
    </segmentType>

    <!-- PER — Administrative Communications Contact -->
    <segmentType name="PER">
        <sequence>
            <element type="E0366" minOccurs="1" />  <!-- PER01: Contact Function Code (CN=Contact, IC=Information Contact) -->
            <element type="E0093" minOccurs="0" />  <!-- PER02: Name -->
            <element type="E0365" minOccurs="0" />  <!-- PER03: Communication Number Qualifier (TE=Telephone, EM=Email, FX=Fax) -->
            <element type="E0364" minOccurs="0" />  <!-- PER04: Communication Number -->
            <element type="E0365" minOccurs="0" />  <!-- PER05: Communication Number Qualifier 2 -->
            <element type="E0364" minOccurs="0" />  <!-- PER06: Communication Number 2 -->
        </sequence>
    </segmentType>

    <!-- CTT — Transaction Totals -->
    <segmentType name="CTT">
        <sequence>
            <element type="E0354" minOccurs="1" />  <!-- CTT01: Number of Line Items (total HL segments) -->
            <element type="E0347" minOccurs="0" />  <!-- CTT02: Hash Total (sum of SN102 quantities, optional) -->
        </sequence>
    </segmentType>

</schema>