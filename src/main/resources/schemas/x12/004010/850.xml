<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://xlate.io/EDISchema/v4">

    <!-- ============================================================ -->
    <!-- TRANSACTION STRUCTURE (segment order + loop occurrence rules) -->
    <!-- ============================================================ -->
    <transaction>
        <sequence>

            <segment type="BEG" minOccurs="1" maxOccurs="1" />
            <segment type="CUR" minOccurs="0" maxOccurs="1"/>
            <segment type="REF" minOccurs="0" maxOccurs="12" />
            <segment type="PER" minOccurs="0" maxOccurs="3" />
            <segment type="FOB" minOccurs="0" maxOccurs="1"/>
            <segment type="CSH" minOccurs="0" maxOccurs="1"/>
            <segment type="ITD" minOccurs="0" maxOccurs="5"/>
            <segment type="DTM" minOccurs="0" maxOccurs="10" />

            <!-- Loop 1000 - Party Name -->
            <loop code="1000" minOccurs="0" maxOccurs="10">
                <sequence>
                    <segment type="N1"  minOccurs="1" maxOccurs="1" />
                    <segment type="N3"  minOccurs="0" maxOccurs="2" />
                    <segment type="N4"  minOccurs="0" maxOccurs="1" />
                    <segment type="REF" minOccurs="0" maxOccurs="12" />
                </sequence>
            </loop>

            <!-- Loop 2000 - Line Items -->
            <loop code="2000" minOccurs="1" maxOccurs="100000">
                <sequence>
                    <segment type="PO1" minOccurs="1" maxOccurs="1" />
                    <segment type="PID" minOccurs="0" maxOccurs="1000" />
                    <segment type="PO4" minOccurs="0" maxOccurs="25"/>
                    <segment type="SAC" minOccurs="0" maxOccurs="25"/>
                    <segment type="REF" minOccurs="0" maxOccurs="12" />
                </sequence>
            </loop>

            <segment type="CTT" minOccurs="1" maxOccurs="1" />
            <segment type="AMT" minOccurs="0" maxOccurs="1" />

        </sequence>
    </transaction>

    <!-- ============================================================ -->
    <!-- ELEMENT TYPE DEFINITIONS                                      -->
    <!-- base: string | numeric | decimal | date | time | identifier  -->
    <!-- ============================================================ -->

    <!-- Common elements -->
    <elementType name="E0001" base="identifier" minLength="2" maxLength="2" />   <!-- Transaction Set Purpose Code -->
    <elementType name="E0092" base="identifier" minLength="2" maxLength="2" />   <!-- PO Type Code -->
    <elementType name="E0324" base="string"     minLength="1" maxLength="22" />  <!-- PO Number -->
    <elementType name="E0373" base="date"       minLength="8" maxLength="8" />   <!-- Date -->
    <elementType name="E0128" base="identifier" minLength="2" maxLength="3" />   <!-- Reference ID Qualifier -->
    <elementType name="E0127" base="string"     minLength="1" maxLength="50" />  <!-- Reference ID -->
    <elementType name="E0366" base="identifier" minLength="2" maxLength="2" />   <!-- Contact Function Code -->
    <elementType name="E0093" base="string"     minLength="1" maxLength="60" />  <!-- Name -->
    <elementType name="E0365" base="identifier" minLength="2" maxLength="2" />   <!-- Communication Type -->
    <elementType name="E0364" base="string"     minLength="1" maxLength="80" />  <!-- Communication Number -->
    <elementType name="E0098" base="identifier" minLength="2" maxLength="3" />   <!-- Entity ID Code -->
    <elementType name="E0093b" base="string"    minLength="1" maxLength="60" />  <!-- Company Name -->
    <elementType name="E0066" base="identifier" minLength="1" maxLength="2" />   <!-- ID Code Qualifier -->
    <elementType name="E0067" base="string"     minLength="2" maxLength="80" />  <!-- ID Code -->
    <elementType name="E0166" base="string"     minLength="1" maxLength="55" />  <!-- Address -->
    <elementType name="E0019" base="string"     minLength="2" maxLength="30" />  <!-- City -->
    <elementType name="E0156" base="identifier" minLength="2" maxLength="2" />   <!-- State Code -->
    <elementType name="E0116" base="string"     minLength="3" maxLength="15" />  <!-- Postal Code -->
    <elementType name="E0026" base="identifier" minLength="2" maxLength="3" />   <!-- Country Code -->
    <elementType name="E0350" base="string"     minLength="1" maxLength="20" />  <!-- Assigned ID -->
    <elementType name="E0330" base="decimal"    minLength="1" maxLength="15" />  <!-- Quantity -->
    <elementType name="E0355" base="identifier" minLength="2" maxLength="2" />   <!-- Unit of Measure -->
    <elementType name="E0212" base="decimal"    minLength="1" maxLength="17" />  <!-- Unit Price -->
    <elementType name="E0235" base="identifier" minLength="2" maxLength="2" />   <!-- Product ID Qualifier -->
    <elementType name="E0234" base="string"     minLength="1" maxLength="48" />  <!-- Product ID -->
    <elementType name="E0354" base="numeric"    minLength="1" maxLength="6" />   <!-- Number of Line Items -->
    <elementType name="E0360" base="identifier" minLength="2" maxLength="3" />
    <elementType name="E0361" base="string" minLength="1" maxLength="80" />
    <elementType name="E0362" base="string" minLength="1" maxLength="80" />
    <elementType name="E0100" base="identifier" minLength="3" maxLength="3" /> <!-- E0100 - Currency Code -->
    <elementType name="E0212" base="decimal" minLength="1" maxLength="17" /> <!-- E0212 - Exchange Rate -->

    <!-- FOB (Free on Board) -->
    <elementType name="E0336" base="identifier" minLength="2" maxLength="2"/>   <!-- FOB01: Shipment Method of Payment -->
    <elementType name="E0146" base="identifier" minLength="2" maxLength="2"/>   <!-- FOB02: Location Qualifier -->
    <elementType name="E0147" base="string"     minLength="1" maxLength="80"/>  <!-- FOB03: Description -->

    <!-- CSH (Sales Requirements) -->
    <elementType name="E0352" base="identifier" minLength="1" maxLength="2"/>   <!-- CSH01: Sales Requirement Code -->
    <elementType name="E0325" base="string"     minLength="1" maxLength="20"/>  <!-- CSH02: Description -->

    <!-- ITD (Terms of Sale/Deferred Terms) -->
    <elementType name="E0336b" base="identifier" minLength="2" maxLength="2"/>  <!-- ITD01: Terms Type Code -->
    <elementType name="E0350b" base="string"     minLength="1" maxLength="20"/> <!-- ITD02: Terms Basis Date Code -->
    <elementType name="E0212b" base="decimal"    minLength="1" maxLength="17"/> <!-- ITD03: Discount Percent -->
    <elementType name="E0373b" base="date"       minLength="8" maxLength="8"/>  <!-- ITD04: Discount Due Date -->
    <elementType name="E0373c" base="date"       minLength="8" maxLength="8"/>  <!-- ITD05: Net Due Date -->
    <elementType name="E0782b" base="decimal"    minLength="1" maxLength="18"/> <!-- ITD06: Terms Discount Amount -->

    <elementType name="E0354b" base="numeric" minLength="1" maxLength="6"/>   <!-- Net Days -->
    <elementType name="E0354c" base="numeric" minLength="1" maxLength="6"/>   <!-- Deferred Days -->
    <elementType name="E0782c" base="decimal" minLength="1" maxLength="18"/>  <!-- Deferred Amount -->
    <elementType name="E0373d" base="date" minLength="8" maxLength="8"/>      <!-- Deferred Due Date -->
    <elementType name="E0127b" base="string" minLength="1" maxLength="50"/> <!-- ITD12: Reference/Additional Terms -->

    <!-- PO4 - Item Physical Details -->
    <elementType name="E0382" base="numeric"    minLength="1" maxLength="7"/>   <!-- PO401: Pack -->
    <elementType name="E0334" base="numeric"    minLength="1" maxLength="9"/>   <!-- PO402: Size -->
    <elementType name="E0355" base="identifier" minLength="2" maxLength="2"/>   <!-- PO403: Unit of Measure -->

    <!-- SAC - Service, Promotion, Allowance, or Charge -->
    <elementType name="E0248" base="identifier" minLength="1" maxLength="1"/>   <!-- SAC01: Allowance/Charge Indicator -->
    <elementType name="E0249" base="identifier" minLength="4" maxLength="4"/>   <!-- SAC02: Service/Charge Code -->
    <elementType name="E0782d" base="decimal"    minLength="1" maxLength="18"/> <!-- SAC04: Amount -->
    <elementType name="E0362b" base="string"     minLength="1" maxLength="80"/> <!-- SAC12: Description -->

    <elementType name="E0127c" base="string"     minLength="1" maxLength="50"/> <!-- Reference ID -->
    <elementType name="E0127d" base="string"     minLength="1" maxLength="50"/> <!-- Reference ID -->
    <elementType name="E0127e" base="string"     minLength="1" maxLength="50"/> <!-- Reference ID -->
    <elementType name="E0127f" base="string"     minLength="1" maxLength="50"/> <!-- Reference ID -->
    <elementType name="E0127g" base="string"     minLength="1" maxLength="50"/> <!-- Reference ID -->
    <elementType name="E0373e" base="date"       minLength="8" maxLength="8"/>  <!-- Date -->
    <elementType name="E0373f" base="date"       minLength="8" maxLength="8"/>  <!-- Date -->
    <elementType name="E0355b" base="identifier" minLength="2" maxLength="2"/>  <!-- Unit of Measure -->
    <elementType name="E0330b" base="decimal"    minLength="1" maxLength="15"/> <!-- Quantity -->
    <elementType name="E0212c" base="decimal"    minLength="1" maxLength="17"/> <!-- Rate -->
    <elementType name="E0212d" base="decimal"    minLength="1" maxLength="17"/> <!-- Rate -->





    <!-- ============================================================ -->
    <!-- SEGMENT TYPE DEFINITIONS (element-level validation rules)    -->
    <!-- ============================================================ -->

    <!-- BEG - Beginning Segment for PO -->
    <segmentType name="BEG">
        <sequence>
            <element type="E0001" minOccurs="1" />  <!-- BEG01: Purpose Code -->
            <element type="E0092" minOccurs="1" />  <!-- BEG02: PO Type Code -->
            <element type="E0324" minOccurs="1" />  <!-- BEG03: PO Number -->
            <element type="E0324" minOccurs="0" />  <!-- BEG04: Release Number (not used) -->
            <element type="E0373" minOccurs="1" />  <!-- BEG05: Date (mandatory) -->
        </sequence>
    </segmentType>

    <segmentType name="CUR">
        <sequence>
            <element type="E0098" minOccurs="1"/>   <!-- CUR01: Entity Identifier Code -->
            <element type="E0100" minOccurs="1"/>   <!-- CUR02: Currency Code -->
            <element type="E0212" minOccurs="0"/>   <!-- CUR03: Exchange Rate (optional) -->
        </sequence>
    </segmentType>


    <!-- REF - Reference Identification -->
    <segmentType name="REF">
        <sequence>
            <element type="E0128" minOccurs="1" />  <!-- REF01: Qualifier -->
            <element type="E0127" minOccurs="0" />  <!-- REF02: Reference ID -->
        </sequence>
    </segmentType>

    <!-- PER - Administrative Communications Contact -->
    <segmentType name="PER">
        <sequence>
            <element type="E0366" minOccurs="1" />  <!-- PER01: Contact Function Code -->
            <element type="E0093" minOccurs="0" />  <!-- PER02: Name -->
            <element type="E0365" minOccurs="0" />  <!-- PER03: Comm Type -->
            <element type="E0364" minOccurs="0" />  <!-- PER04: Comm Number -->
        </sequence>
    </segmentType>

    <!-- FOB - Free on Board Instructions -->
    <segmentType name="FOB">
        <sequence>
            <element type="E0336" minOccurs="1"/>   <!-- FOB01: Shipment Method of Payment -->
            <element type="E0146" minOccurs="0"/>   <!-- FOB02: Location Qualifier -->
            <element type="E0147" minOccurs="0"/>   <!-- FOB03: Description -->
        </sequence>
    </segmentType>

    <!-- CSH - Sales Requirements -->
    <segmentType name="CSH">
        <sequence>
            <element type="E0352" minOccurs="1"/>   <!-- CSH01: Sales Requirement Code -->
            <element type="E0325" minOccurs="0"/>   <!-- CSH02: Description -->
        </sequence>
    </segmentType>

    <!-- ITD - Terms of Sale/Deferred Terms -->
    <segmentType name="ITD">
        <sequence>
            <element type="E0336b" minOccurs="0"/>  <!-- ITD01: Terms Type Code -->
            <element type="E0350b" minOccurs="0"/>  <!-- ITD02: Terms Basis Date Code -->
            <element type="E0212b" minOccurs="0"/>  <!-- ITD03: Discount Percent -->
            <element type="E0373b" minOccurs="0"/>  <!-- ITD04: Discount Due Date -->
            <element type="E0354b" minOccurs="0"/>  <!-- ITD05: Net Days -->
            <element type="E0782b" minOccurs="0"/>  <!-- ITD06: Terms Discount Amount -->
            <element type="E0373c" minOccurs="0"/>  <!-- ITD07: Terms Discount Due Date -->
            <element type="E0354c" minOccurs="0"/>  <!-- ITD08: Deferred Amount Due Days -->
            <element type="E0782c" minOccurs="0"/>  <!-- ITD09: Deferred Amount -->
            <element type="E0373d" minOccurs="0"/>  <!-- ITD10: Deferred Due Date -->
            <element type="E0362"  minOccurs="0"/>  <!-- ITD11: Description -->
            <element type="E0127b" minOccurs="0"/>  <!-- ITD12: Reference/Additional Terms -->
        </sequence>
    </segmentType>



    <!-- DTM - Date/Time Reference -->
    <segmentType name="DTM">
        <sequence>
            <element type="E0374" minOccurs="1" />
            <element type="E0373" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N1 - Party Name -->
    <segmentType name="N1">
        <sequence>
            <element type="E0098"  minOccurs="1" />  <!-- N101: Entity ID Code -->
            <element type="E0093b" minOccurs="0" />  <!-- N102: Name -->
            <element type="E0066"  minOccurs="0" />  <!-- N103: ID Qualifier -->
            <element type="E0067"  minOccurs="0" />  <!-- N104: ID Code -->
        </sequence>
    </segmentType>

    <!-- N3 - Address -->
    <segmentType name="N3">
        <sequence>
            <element type="E0166" minOccurs="1" />
            <element type="E0166" minOccurs="0" />
        </sequence>
    </segmentType>

    <!-- N4 - Geographic Location -->
    <segmentType name="N4">
        <sequence>
            <element type="E0019" minOccurs="0" />  <!-- City -->
            <element type="E0156" minOccurs="0" />  <!-- State -->
            <element type="E0116" minOccurs="0" />  <!-- ZIP -->
            <element type="E0026" minOccurs="0" />  <!-- Country -->
        </sequence>
    </segmentType>

    <!-- PO1 - Baseline Item Data -->
    <segmentType name="PO1">
        <sequence>
            <element type="E0350" minOccurs="0"/>   <!-- PO101 -->
            <element type="E0330" minOccurs="1"/>   <!-- PO102 -->
            <element type="E0355" minOccurs="1"/>   <!-- PO103 -->
            <element type="E0212" minOccurs="0"/>   <!-- PO104 -->
            <element type="E0235" minOccurs="0"/>   <!-- PO105 -->
            <!-- Repeat qualifier + ID pairs -->
            <element type="E0235" minOccurs="0"/>   <!-- PO106 -->
            <element type="E0234" minOccurs="0"/>   <!-- PO107 -->
            <element type="E0235" minOccurs="0"/>   <!-- PO108 -->
            <element type="E0234" minOccurs="0"/>   <!-- PO109 -->
            <element type="E0235" minOccurs="0"/>   <!-- PO110 -->
            <element type="E0234" minOccurs="0"/>   <!-- PO111 -->
            <element type="E0235" minOccurs="0"/>   <!-- PO112 -->
            <element type="E0234" minOccurs="0"/>   <!-- PO113 -->
            <!-- … continue until PO125 -->
        </sequence>
    </segmentType>


    <!-- PID - Product/Item Description -->
    <segmentType name="PID">
        <sequence>
            <element type="E0349" minOccurs="1"/>   <!-- PID01: Item Description Type -->
            <element type="E0350" minOccurs="0"/>   <!-- PID02: Characteristic Code -->
            <element type="E0360" minOccurs="0"/>   <!-- PID03: Description Code -->
            <element type="E0361" minOccurs="0"/>   <!-- PID04: Description -->
            <element type="E0362" minOccurs="0"/>   <!-- PID05: Description Text -->
        </sequence>
    </segmentType>

    <!-- PO4 - Item Physical Details -->
    <segmentType name="PO4">
        <sequence>
            <element type="E0382" minOccurs="0"/>   <!-- PO401: Pack -->
            <element type="E0334" minOccurs="0"/>   <!-- PO402: Size -->
            <element type="E0355" minOccurs="0"/>   <!-- PO403: Unit of Measure -->
        </sequence>
    </segmentType>

    <!-- SAC - Service, Promotion, Allowance, or Charge -->
    <segmentType name="SAC">
        <sequence>
            <element type="E0248"  minOccurs="1"/>   <!-- SAC01: Allowance/Charge Indicator -->
            <element type="E0249"  minOccurs="0"/>   <!-- SAC02: Service/Charge Code -->
            <element type="E0127c" minOccurs="0"/>   <!-- SAC03: Reference ID -->
            <element type="E0127d" minOccurs="0"/>   <!-- SAC04: Reference ID -->
            <element type="E0782d" minOccurs="0"/>   <!-- SAC05: Amount -->
            <element type="E0373e" minOccurs="0"/>   <!-- SAC06: Date -->
            <element type="E0373f" minOccurs="0"/>   <!-- SAC07: Date -->
            <element type="E0355b" minOccurs="0"/>   <!-- SAC08: Unit of Measure -->
            <element type="E0330b" minOccurs="0"/>   <!-- SAC09: Quantity -->
            <element type="E0212c" minOccurs="0"/>   <!-- SAC10: Rate -->
            <element type="E0212d" minOccurs="0"/>   <!-- SAC11: Rate -->
            <element type="E0362b" minOccurs="0"/>   <!-- SAC12: Description -->
            <element type="E0127e" minOccurs="0"/>   <!-- SAC13: Reference ID -->
            <element type="E0127f" minOccurs="0"/>   <!-- SAC14: Reference ID -->
            <element type="E0127g" minOccurs="0"/>   <!-- SAC15: Reference ID -->
        </sequence>
    </segmentType>




    <!-- CTT - Transaction Totals -->
    <segmentType name="CTT">
        <sequence>
            <element type="E0354" minOccurs="1" />  <!-- CTT01: Number of Line Items (mandatory) -->
        </sequence>
    </segmentType>

    <!-- AMT - Monetary Amount -->
    <segmentType name="AMT">
        <sequence>
            <element type="E0522" minOccurs="1" />
            <element type="E0782" minOccurs="1" />
        </sequence>
    </segmentType>

    <!-- Extra element types needed by DTM, PID, AMT -->
    <elementType name="E0374" base="identifier" minLength="3" maxLength="3" />  <!-- Date/Time Qualifier -->
    <elementType name="E0349" base="identifier" minLength="1" maxLength="1" />  <!-- Item Description Type -->
    <elementType name="E0522" base="identifier" minLength="2" maxLength="3" />  <!-- Amount Qualifier -->
    <elementType name="E0782" base="decimal"    minLength="1" maxLength="18" /> <!-- Monetary Amount -->

</schema>
